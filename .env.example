# Prepio - Environment Variables
# Copy this file to .env.local and fill in your values.
#
# Only actual secrets and per-environment values belong here.
# Static app config (models, timeouts, permanent feature switches) lives in code:
#   supabase/functions/_shared/config.ts
# Environment-specific rollout gates are documented below and default off.

# =============================================================================
# FRONTEND (exposed to the browser via Vite)
# =============================================================================

# Supabase project URL and publishable (anon) key
# Found in: Supabase Dashboard -> Settings -> API Keys
VITE_SUPABASE_URL=https://vjwrirrqprjzdorignlz.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_...

# Default-off rollout gate for sending the structured profile into research.
# The Edge Function flag below must also be enabled.
VITE_PROFILE_STORY_LINKING=false

# =============================================================================
# SUPABASE EDGE FUNCTIONS (set as secrets in Supabase Dashboard)
# =============================================================================

# Supabase connection (edge functions create their own admin client)
SUPABASE_URL=https://vjwrirrqprjzdorignlz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenAI — used for all research analysis steps
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Tavily — used for web search and content extraction
# Get from: https://tavily.com
TAVILY_API_KEY=tvly-...

# Default-off server half of structured profile story linking.
PROFILE_STORY_LINKING=false

# Stripe — used by create-checkout-session and stripe-webhook
# Set these separately in Stripe test mode and live mode environments.
# Product/Price setup contract: docs/BILLING.md
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_QUARTERLY=price_...
STRIPE_PRICE_ANNUAL=price_...
APP_BASE_URL=http://localhost:5173

# Optional: override the default model for all operations (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# Optional: comma-separated allowlist of origins the edge functions echo back
# in CORS responses. When unset, functions fall back to "*". Set in production
# to the deployed APP_BASE_URL plus any preview origins.
# APP_ALLOWED_ORIGINS=https://prepio.app,https://prepio.vercel.app

# =============================================================================
# LEGACY DENO TESTS (local/non-production only)
# =============================================================================

# Required by `make test`. Use a dedicated, disposable account in a local or
# non-production Supabase project. Never use a personal account or production
# credentials; the legacy suite signs in and writes test data.
TEST_USER_EMAIL=test-user@example.invalid
TEST_USER_PASSWORD=replace-with-a-non-production-test-password
